{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ui_ts/frontend && npm install",
  "buildCommand": "cd ui_ts/frontend && npm run build",
  "outputDirectory": "ui_ts/frontend/dist",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
